# Copy to .env.local. Leave both empty to run in local-only mode (no sign-in).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Where magic links and OAuth send people back to. Use the deployed origin in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server only (no NEXT_PUBLIC_ prefix): lets signed-in users have Claude read a resume on import.
# Leave empty to fall back to the date-pattern parser. Mark it sensitive on Vercel.
ANTHROPIC_API_KEY=
